# Admin password for /admin. REQUIRED.
# Without it the app still serves the public calculator, but the admin panel
# cannot log in and /api/config writes are refused (503) — it fails closed.
ADMIN_PASSWORD=

# Optional. Signs admin session cookies; defaults to ADMIN_PASSWORD.
# Set this to rotate sessions without changing the password (and vice versa).
ADMIN_SESSION_SECRET=

# Where config.json lives. Must be a writable, persistent path.
# Railway: mount a volume and point this at it (the Dockerfile defaults to /data).
# Local dev: leave unset to use ./data.
DATA_DIR=/data
